# ==============================================================================
# TaskFlow SaaS - Environment Variables Template
# Copy this file to .env and fill in your actual production/secret values.
# NEVER commit your real .env file with secrets to GitHub!
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=generate-a-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Domains & URLs ---
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# --- Database (Aiven MySQL or Cloud Database) ---
# Option A: Full Connection URI from Aiven (Recommended)
DATABASE_URL=mysql://avnadmin:your_password@your-aiven-host.aivencloud.com:port/defaultdb?ssl_mode=REQUIRED

# Option B: Individual database fields (if not using DATABASE_URL)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_password
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=your_port
# DB_SSL_MODE=REQUIRED

# --- Celery & Redis (Upstash) ---
CELERY_BROKER_URL=rediss://default:your_upstash_password@your-upstash-host.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:your_upstash_password@your-upstash-host.upstash.io:6379

# --- Cloudinary (Media / File Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Email Settings (Gmail SMTP for notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# --- Razorpay Configuration ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- JWT Configuration (Optional) ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1
TIME_ZONE=Asia/Kolkata
